# Optional demo switch for fully client-side demo data
NEXT_PUBLIC_DEMO_MODE=false

# Only accounts with is_admin=1 in the database can log in. There is no public
# registration; provision the first account with `npm run seed:admin -- <email> <password>`.
SINGLE_ADMIN_MODE=true

# Full reset-password URL used when generating recovery links
APP_URL=http://localhost:3000/reset-password

# Optional webhook for product request form
REQUEST_WEBHOOK_URL=

# Optional webhook for password reset delivery
PASSWORD_RESET_WEBHOOK_URL=

# Optional secret for cryptographic helpers
ENCRYPTION_KEY=

# Path to the local SQLite database file
SQLITE_DB_PATH=./data/novinki.db

# Base path the app is served under (e.g. /novinki if mounted on a subpath)
NEXT_PUBLIC_BASE_PATH=
